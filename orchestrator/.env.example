# ── NATS Configuration ───────────────────────────────────────────────────────
# The URL of the NATS message broker used for agent communication.
# Change this if your NATS server is not on localhost or uses a non-default
# port.
NATS_URL=nats://localhost:4222

# ── Orchestrator Behaviour ───────────────────────────────────────────────────
# Default timeout (seconds) for waiting on an agent result.
# ORCHESTRATOR_TIMEOUT=30.0
